---
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import logo from '../logo.png';
---

<header>
  <a href="/" class="logo">
    <Image src={logo} alt="IGNiTE GOD’S LITE LLC" />
  </a>

  <nav>
    <ul>
      <li class="home"><a href="/">Home</a></li>
      <li class="about"><a href="/about">About</a></li>
      <li class="testimonials">
        <a href="/testimonials">Testimonials</a>
      </li>
      <li><Button href="/book">Book a call</Button></li>
    </ul>
  </nav>
  <!-- <blockquote> But my God shall supply all your need according to his riches in glory by Christ Jesus. <cite>Philippians 4:19</cite> </blockquote> -->
  <blockquote>
    CONFIDENCE, CONTENTMENT, COMPASSION & COURAGE
    <cite>Philippians 4:13,19; Jude 1:22; Nehemiah 5:19</cite>
  </blockquote>
</header>

<style>
  header {
    display: grid;
    grid-template:
      'logo quote .'
      'logo nav .' / auto auto var(--space-l);
    background: var(--color-logo);
    box-shadow: var(--box-shadow);
  }
  a.logo {
    grid-area: logo;
  }
  nav {
    grid-area: nav;
  }
  blockquote {
    color: var(--color-surface);
    grid-area: quote;
    font-size: var(--fs--2);
    padding: 1em;
    text-align: right;
  }
  .logo img {
    width: 20rem;
    mask-image: linear-gradient(
      to right,
      /* rgba(0, 0, 0, 0) 0%, */ /* rgba(0, 0, 0, 1) 25%, */ rgba(0, 0, 0, 1)
        75%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  ul {
    --_spacing: var(--space-l);
    display: flex;
    align-items: center;
    column-gap: var(--_spacing);
    flex-wrap: wrap;
    justify-content: end;

    padding: 0;
  }
  nav a {
    display: inline-block;
    color: var(--color-surface);
    transition: all 0.5s;
    text-decoration: none;
    &:hover {
      color: var(--color-glow);
      text-shadow: 0 0 0.125em;
      transform: translate(0, -4px);
    }
  }
  @media (width<65rem) {
    header {
      grid-template: 'logo' 'quote' 'nav' '.' 1rem;
    }
    .logo img {
      width: 100%;
      max-width: 50rem;
      margin-inline: auto;

      mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 25%,
        rgba(0, 0, 0, 1) 75%,
        rgba(0, 0, 0, 0) 100%
      );
    }
    blockquote {
      text-align: center;
    }
    ul {
      justify-content: center;
    }
  }
</style>
