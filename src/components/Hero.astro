---
import Button from '../components/Button.astro';
---

<section>
  <h1>Professional Disability Claims Support for Veterans & Civilians</h1>
  <p>
    Filing for benefits can be confusing. The independent authorized
    representatives at <strong>IGNiTE</strong> (In God I Trust Eternally) guide you
    through the Social Security Administration process every step of the way.
  </p>
  <div>
    <Button href="#book">Get Started Today</Button>
  </div>
</section>

