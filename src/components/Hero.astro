---
import Button from '../components/Button.astro';
---

<section class="layout">
  <h1 class="wide">
    Professional Disability Claims Support for Veterans & Civilians
    <!--     Professional assistance for military and civilians filing disability claims -->
  </h1>
  <p>
    Filing for benefits can be confusing. The independent authorized
    representatives at <strong>IGNiTE</strong> (In God's Name I Trust Eternally) guide you
    through the Social Security Administration process every step of the way.
    <!-- <strong>IGNiTE</strong> (In God I Trust Eternally) are Independently Operated Authorized Representatives who can assist in filing either civilian or military disability claims with the Social Security Administration -->
  </p>
  <div>
    <Button href="/book" />
  </div>
</section>

<style>
  section {
    /* display: flex; */
    flex-direction: column;
    row-gap: var(--space-l);

    padding: var(--space-m);
    min-height: 50vh;

    color: var(--color-text);

    background:
      linear-gradient(
        hsl(from var(--color-surface) h s l / 0%),
        hsl(from var(--color-surface) h s l / 90%)
      ),
      url(/img/flagbg.jpg) center / cover var(--color-surface);
    box-shadow: var(--box-shadow);
  }
  h1 {
    font-size: var(--fs-3);
  }
  div {
    margin-inline: auto;
  }
</style>
