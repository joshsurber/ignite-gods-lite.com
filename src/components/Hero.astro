<style>
  section {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-l);

    padding: var(--space-m);
    min-height: 50vh;

    color: var(--color-text);

    --_color: var(--color-surface);
    background-image:
      linear-gradient(
        hsl(from var(--_color) h s l / 0%),
        hsl(from var(--_color) h s l / 50%)
      ),
      url(/img/flagbg.jpg);
    background-size: cover;
    background-color: var(--color-text);
    box-shadow: 0 0 1rem gray;
  }
  h1 {
    font-size: var(--fs-3);
  }
  div {
    margin-inline: auto;
  }
</style>
