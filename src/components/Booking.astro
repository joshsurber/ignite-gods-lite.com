---
const { url } = Astro.props;
---

<div>
  <iframe src={url} title="Schedule your consultation"></iframe>
</div>

<style>
  /* Inline Booking Container */
  div {
    position: relative;
    background: #ffffff;
    border: 1px solid rgba(20, 38, 74, 0.1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.02);
    margin-top: 1rem;
    min-height: 600px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 650px;
    border: none;
  }
</style>
