<style>
  footer {
    font-size: var(--fs--1);
    display: grid;
    grid-template:
      'quote quote'
      'contact barbi'
      'bbb barbi'
      'fine fine' / 1fr 1fr;
    margin-block-start: var(--space-3xl);

    gap: var(--space-s);
    padding: var(--space-xl) var(--space-m);
    background: var(--color-surface);
    box-shadow: var(--box-shadow);

    @media (width<60em) {
      grid-template:
        'quote'
        'barbi'
        'contact'
        'bbb'
        'fine'/1fr;
    }
  }
  blockquote {
    grid-area: quote;
  }
  ul {
    grid-area: contact;
    max-width: 65ch;
    margin-inline: auto;
  }
  p.barbi {
    grid-area: barbi;
    max-width: 65ch;
    margin-inline: auto;
  }
  p.bbb {
    grid-area: bbb;
    max-width: 65ch;
    margin-inline: auto;
  }
  .fineprint {
    margin-block-start: var(--space-s);
    grid-area: fine;
  }
  blockquote,
  .fineprint {
    font-size: var(--fs--2);
    text-align: center;
  }
</style>
