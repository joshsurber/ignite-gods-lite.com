<style>
  footer {
    font-size: var(--fs--1);
    display: grid;
    grid-template:
      'quote quote'
      'contact barbi'
      'contact bbb'
      'fine fine' / 1fr 1fr;
    margin-block-start: var(--space-3xl);

    gap: var(--space-s);
    padding: var(--space-xl) var(--space-m) 0;
    background: var(--color-surface);
    box-shadow: var(--box-shadow);

    @media (width<60rem) {
      grid-template:
        'quote'
        'barbi'
        'contact'
        'bbb'
        'fine'/1fr;
    }
  }
  div.bible {
    grid-area: quote;
  }
  ul {
    grid-area: contact;
    max-width: 65ch;
    margin-inline: auto;
    padding: 0;
  }
  p.barbi {
    grid-area: barbi;
    max-width: 65ch;
    margin-inline: auto;
  }
  p.bbb {
    grid-area: bbb;
    max-width: 65ch;
    margin-inline: auto;
  }
  .fineprint {
    margin-block-start: var(--space-s);
    grid-area: fine;
  }
  .jude122 {
    color: var(--color-accent);
    font-size: var(--fs-0);
    text-align: center;
    font-weight: bold;
  }
  .fineprint {
    font-size: var(--fs--2);
    text-align: center;
  }
</style>
