---
import Card from './Card.astro';
const { cite = false, ...rest } = Astro.props;
---

<Card {...rest}>
  <blockquote class="prose">
    <slot />
    {cite && <cite>{cite}</cite>}
  </blockquote>
</Card>

<style>
  blockquote {
    position: relative;
    padding: var(--space-l);
    border-radius: 1rem;
    /* margin-bottom: 2rem; */
    text-align: left;
    margin-top: 0;

    &::before {
      position: absolute;
      font-size: 8rem;
      font-family: serif;
      color: hsl(from currentColor h s l / 0.15);
      line-height: 1;
      content: '“';
      /* top: -0.25em; */
      /* left: -0.25em; */
      top: 0;
      left: 0;
    }

    /* Highlights key phrases within the text */
    strong {
      background: linear-gradient(
        180deg,
        transparent 60%,
        hsl(218, 100%, 70%, 0.2) 40%
      );
      font-weight: 600;
      /* padding: 0 4px; */
      color: var(--color-brand);
    }

    /* Elegant, clean styling for the author attribution */
    cite {
      display: block;

      margin-top: 24px;

      color: var(--color-brand);
      font-size: 0.95rem;
      font-style: normal; /* Removes default browser italicization */
      font-weight: 600;
      letter-spacing: 0.5px;
      text-align: right;
      text-transform: uppercase;

      /* Subtle horizontal line separator before the name */
      &::before {
        content: '— ';
        margin-right: 4px;
        opacity: 0.6;
      }
    }
  }
</style>
