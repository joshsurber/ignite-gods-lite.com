---
import BaseLayout from './BaseLayout.astro';
const { title, formLink, heroText, heroMinor } =
  Astro.props.frontmatter || Astro.props;

// Replace this URL with the Google Calendar booking link once she provides it.
// Default placeholder uses her existing Acuity link.
const schedulingUrl =
  'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0nhqIGybhpqREgcMAk4eioz0gwd94oYIWxsSfnvL6C3BtuTLvx0Fz-aS29ys__UMYWlD6uhnww?gv=true';
---

<BaseLayout {title} {heroText} {heroMinor} bodyClass="thankyou">
  <p>Hello and thank you for your interest in IGNiTE GOD’S LITE LLC!</p>

  <p>
    Barbi J Law is excited to have an opportunity to speak to you by phone to
    share how IGNiTE GOD’S LITE, LLC can assist you in filing your Social
    Security Disability Claim. <strong class="bigred"
      >Please complete the following two remaining steps:</strong
    >
  </p>

  <div class="thankyou-steps">
    <!-- Step 1: Schedule Phone Consultation -->
    <div class="step-card">
      <span class="step-badge">Step 1</span>
      <h3 class="step-title">Schedule your phone consultation</h3>
      <p style="margin-bottom: 1rem;">
        Choose a time that works best for you directly below. Once booked, it
        will automatically sync to Barbi's calendar.
      </p>

      <div class="booking-container">
        <iframe
          src={schedulingUrl}
          title="Schedule your consultation"
          class="booking-iframe"></iframe>
      </div>
    </div>

    <!-- Step 2: Complete the Information Form -->
    <div class="step-card" style="text-align: center;">
      <span class="step-badge">Step 2</span>
      <h3 class="step-title">Complete your short information form</h3>
      <p
        style="margin-bottom: 1.5rem; max-width: 600px; margin-left: auto; margin-right: auto;"
      >
        Please fill out this form prior to your scheduled consultation so Barbi
        can review your details ahead of time.
      </p>
      <a
        href={formLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-accent"
      >
        Complete Information Form &rarr;
      </a>
    </div>
  </div>

  <p style="margin-top: 2rem;">
    Please note, after scheduling your appointment, it is your responsibility to
    initiate the contact by phone to our scheduling representative, <strong
      >Tami at 231-519-8014</strong
    >, at the time you have scheduled.
  </p>

  <p>
    Payment terms and options will be discussed at the initial screening
    appointment. Initial phone screen is at <strong>NO CHARGE</strong>.
  </p>

  <p>
    If you forget your appointment, please feel free to email IGNiTE GOD’S LITE,
    LLC at <a href="mailto:jude1.22@ignite-gods-lite.com"
      >jude1.22@ignite-gods-lite.com</a
    > to be given an opportunity to reschedule your appointment.
  </p>

  <slot />
</BaseLayout>
